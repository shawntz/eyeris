{
  "name": "eyeris-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Pupillometry preprocessing and epoch review",
  "author": "Shawn Schwartz",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run icons && tsc --noEmit && vite build",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build && playwright test",
    "demo": "node scripts/demo.mjs",
    "icons": "node scripts/icons.mjs",
    "package:prepare": "npm run build && node scripts/bundle-runtime.mjs",
    "package": "npm run package:prepare && electron-builder --publish never",
    "package:sign": "node scripts/release.mjs --sign",
    "package:release": "node scripts/release.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "runtime:prepare": "node scripts/bundle-runtime.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "prettier": "^3.9.9",
    "semver": "7.8.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
