Package: eyeris
Type: Package
Title: Flexible, Extensible, & Reproducible Processing of Pupil Data
Version: 1.0.0
Authors@R:
  person(
    given = "Shawn",
    family = "Schwartz",
    role = c("aut", "cre", "cph"),
    email = "stschwartz@stanford.edu", 
    comment = c(ORCID = "0000-0001-6444-8451")
